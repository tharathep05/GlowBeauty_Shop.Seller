@{
    Layout = "_Layout";
    ViewData["Title"] = "เข้าสู่ระบบผู้ขาย";
}

<div class="row justify-content-center align-items-center" style="min-vh: 75vh;">
    <div class="col-md-5 col-lg-4">
        <div class="card card-luxury p-4 shadow-sm mt-5">
            <div class="text-center mb-4">
                <div class="mb-2">
                    <i class="bi bi-shield-lock-fill fs-1 text-gold"></i>
                </div>
                <h4 class="fw-bold text-dark mb-1">เข้าสู่ระบบผู้ขาย</h4>
                <p class="text-muted small">GlowBeauty Shop Seller Portal</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center small py-2 mb-3">
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">ชื่อผู้ใช้ (Username)</label>
                    <input type="text" name="username" class="form-control bg-light" placeholder="ระบุ username" required value="admin" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">รหัสผ่าน (Password)</label>
                    <input type="password" name="password" class="form-control bg-light" placeholder="ระบุ password" required value="123456" />
                </div>

                <button type="submit" class="btn btn-gold w-100 py-2 rounded-3 fs-6">
                    เข้าสู่ระบบอย่างปลอดภัย
                </button>
            </form>

            <div class="text-center mt-4">
                <small class="text-muted" style="font-size: 0.8rem;">
                    <i class="bi bi-lock me-1 text-gold"></i> รหัสผ่านจะถูกตรวจสอบด้วย PasswordHash
                </small>
            </div>
        </div>
    </div>
</div>