@model GlowBeauty_Shop.Seller.Models.Product
@{
    ViewData["Title"] = "แก้ไขสินค้า";
}

<div class="my-3" style="max-width: 800px; margin: 0 auto;">
    <div class="mb-4 border-bottom pb-3" style="border-color: var(--lux-border) !important;">
        <span class="text-uppercase" style="letter-spacing: 3px; color: var(--lux-gold); font-size: 0.8rem; font-weight: 500;">Product Management</span>
        <h1 class="display-6 mb-0">แก้ไขสินค้า #@Model.Id</h1>
    </div>

    <div class="card-lux p-4 p-md-5">
        <form asp-action="EditProduct" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">ชื่อสินค้า</label>
                <input asp-for="Name" class="form-control rounded-0" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">หมวดหมู่</label>
                    <input asp-for="Category" class="form-control rounded-0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">ราคา (บาท)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control rounded-0 lux-num" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">จำนวนสต็อก</label>
                    <input asp-for="StockQuantity" type="number" class="form-control rounded-0 lux-num" required />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">รูปภาพปัจจุบัน</label>
                <div class="mb-2">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" style="max-height: 120px; border: 1px solid var(--lux-border);" />
                    }
                    else
                    {
                        <span class="text-muted" style="font-size: 0.85rem;">ยังไม่มีรูปภาพ</span>
                    }
                </div>
                <label class="form-label text-uppercase mt-2" style="font-size: 0.75rem; letter-spacing: 1px;">เปลี่ยนรูปภาพสินค้า (เลือกไฟล์ใหม่หากต้องการเปลี่ยน)</label>
                <input type="file" name="imageFile" class="form-control rounded-0" accept="image/*" />
            </div>

            <div class="mb-4">
                <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">รายละเอียดสินค้า</label>
                <textarea asp-for="Description" class="form-control rounded-0" rows="4"></textarea>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                <label class="form-check-label" for="isActiveCheck">
                    เปิดวางจำหน่ายสินค้านี้
                </label>
            </div>

            <div class="d-flex justify-content-between pt-3 border-top" style="border-color: var(--lux-border) !important;">
                <a asp-action="Products" class="btn btn-lux-outline">ยกเลิก</a>
                <button type="submit" class="btn btn-lux-gold">บันทึกการแก้ไข</button>
            </div>
        </form>
    </div>
</div>