@model GlowBeauty_Shop.Seller.Models.Product
@{
    ViewData["Title"] = "เพิ่มสินค้าใหม่";
}

<div class="my-3" style="max-width: 800px; margin: 0 auto;">
    <div class="mb-4 border-bottom pb-3" style="border-color: var(--lux-border) !important;">
        <span class="text-uppercase" style="letter-spacing: 3px; color: var(--lux-gold); font-size: 0.8rem; font-weight: 500;">Product Management</span>
        <h1 class="display-6 mb-0">เพิ่มสินค้าใหม่</h1>
    </div>

    <div class="card-lux p-4 p-md-5">
        <form asp-controller="Seller" asp-action="CreateProduct" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">ชื่อสินค้า <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control rounded-0" placeholder="ระบุชื่อสินค้า..." required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">หมวดหมู่</label>
                    <input asp-for="Category" class="form-control rounded-0" placeholder="เช่น Skincare, Makeup" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">ราคา (บาท) <span class="text-danger">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control rounded-0 lux-num" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">จำนวนสต็อก <span class="text-danger">*</span></label>
                    <input asp-for="StockQuantity" type="number" min="0" class="form-control rounded-0 lux-num" required />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">รูปภาพสินค้า</label>
                <input type="file" name="imageFile" class="form-control rounded-0" accept="image/*" />
            </div>

            <div class="mb-4">
                <label class="form-label text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">รายละเอียดสินค้า</label>
                <textarea asp-for="Description" class="form-control rounded-0" rows="4" placeholder="กรอกรายละเอียดสินค้า..."></textarea>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" checked />
                <label class="form-check-label" for="isActiveCheck">
                    เปิดวางจำหน่ายสินค้านี้ทันที
                </label>
            </div>

            <div class="d-flex justify-content-between pt-3 border-top" style="border-color: var(--lux-border) !important;">
                <a asp-action="Products" class="btn btn-lux-outline">ยกเลิก</a>
                <button type="submit" class="btn btn-lux-gold">บันทึกสินค้าใหม่</button>
            </div>
        </form>
    </div>
</div>