@model GlowBeauty_Shop.Seller.Models.ProductViewModel

@{
    ViewData["Title"] = "เพิ่มสินค้าใหม่";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-luxury p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0">
                    <i class="bi bi-plus-circle text-gold me-2"></i> เพิ่มสินค้าใหม่เข้าร้าน
                </h4>
                <a asp-action="Index" class="btn btn-outline-gold btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left"></i> ย้อนกลับ
                </a>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold text-muted small">ชื่อสินค้า <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="ระบุชื่อสินค้า" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">หมวดหมู่ <span class="text-danger">*</span></label>
                        <select asp-for="Category" class="form-select" required>
                            <option value="">-- เลือกหมวดหมู่ --</option>
                            <option value="Cleanser">Cleanser</option>
                            <option value="Toner">Toner</option>
                            <option value="Serum">Serum</option>
                            <option value="Moisturizer">Moisturizer</option>
                            <option value="Sunscreen">Sunscreen</option>
                            <option value="Mask">Mask</option>
                            <option value="Makeup">Makeup</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">ราคา (บาท) <span class="text-danger">*</span></label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">สภาพผิวที่เหมาะ</label>
                        <select asp-for="SkinType" class="form-select">
                            <option value="ทุกสภาพผิว">ทุกสภาพผิว</option>
                            <option value="ผิวแพ้ง่าย">ผิวแพ้ง่าย</option>
                            <option value="ผิวมัน">ผิวมัน</option>
                            <option value="ผิวแห้ง">ผิวแห้ง</option>
                            <option value="ผิวเป็นสิว">ผิวเป็นสิว</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">จำนวนสต็อก <span class="text-danger">*</span></label>
                        <input asp-for="StockQuantity" type="number" class="form-control" required />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold text-muted small">รายละเอียดสินค้า</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="กรอกรายละเอียดสินค้า"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">เลือกไฟล์รูปภาพ</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">หรือระบุ URL รูปภาพ</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="เช่น /images/serum1.jpg" />
                    </div>

                    <div class="col-md-12 mt-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="activeSwitch" checked>
                            <label class="form-check-label fw-bold" for="activeSwitch">เปิดวางขายสินค้าทันที</label>
                        </div>
                    </div>

                    <div class="col-md-12 text-end mt-4">
                        <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 me-2">ยกเลิก</a>
                        <button type="submit" class="btn btn-gold rounded-pill px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> บันทึกข้อมูลสินค้า
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>