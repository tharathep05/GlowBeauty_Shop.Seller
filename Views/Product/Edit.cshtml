@model GlowBeauty_Shop.Seller.Models.ProductViewModel

@{
    ViewData["Title"] = "แก้ไขสินค้า";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-luxury p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <h4 class="fw-bold text-dark mb-0">
                    <i class="bi bi-pencil-square text-gold me-2"></i> แก้ไขข้อมูลสินค้า #@Model.Id
                </h4>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-gold btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left"></i> ย้อนกลับ
                </a>
            </div>

            <form asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold text-muted small">ชื่อสินค้า <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">หมวดหมู่ <span class="text-danger">*</span></label>
                        <select asp-for="Category" class="form-select" required>
                            <option value="Cleanser">Cleanser</option>
                            <option value="Toner">Toner</option>
                            <option value="Serum">Serum</option>
                            <option value="Moisturizer">Moisturizer</option>
                            <option value="Sunscreen">Sunscreen</option>
                            <option value="Mask">Mask</option>
                            <option value="Makeup">Makeup</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">ราคา (บาท) <span class="text-danger">*</span></label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">สภาพผิวที่เหมาะ</label>
                        <select asp-for="SkinType" class="form-select">
                            <option value="ทุกสภาพผิว">ทุกสภาพผิว</option>
                            <option value="ผิวแพ้ง่าย">ผิวแพ้ง่าย</option>
                            <option value="ผิวมัน">ผิวมัน</option>
                            <option value="ผิวแห้ง">ผิวแห้ง</option>
                            <option value="ผิวเป็นสิว">ผิวเป็นสิว</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted small">จำนวนสต็อก <span class="text-danger">*</span></label>
                        <input asp-for="StockQuantity" type="number" class="form-control" required />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold text-muted small">รายละเอียดสินค้า</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted small">เปลี่ยนรูปภาพสินค้าใหม่</label>
                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    </div>

                    <div class="col-md-6 align-self-center">
                        <label class="form-label fw-bold text-muted small d-block">รูปภาพปัจจุบัน</label>
                        <img src="@Model.ImageUrl" class="rounded border shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/60';" />
                    </div>

                    <div class="col-md-12 mt-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" id="editActiveSwitch">
                            <label class="form-check-label fw-bold" for="editActiveSwitch">วางขายสินค้า</label>
                        </div>
                    </div>

                    <div class="col-md-12 text-end mt-4">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-secondary rounded-pill px-4 me-2">ยกเลิก</a>
                        <button type="submit" class="btn btn-gold rounded-pill px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> บันทึกการเปลี่ยนแปลง
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>